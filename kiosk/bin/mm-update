#!/bin/bash
# Sjekker origin/master hvert 3. min (kun ls-remote) og tredjepartsmoduler hver 6. time, oppdaterer bare ved endringer, og ruller tilbake hvis speilet ikke kommer opp.
export PATH="$HOME/.local/node/bin:$PATH"
MM="$HOME/MagicMirror"; ST="$HOME/.cache/mm"; mkdir -p "$ST"
cd "$MM" || exit 0
log() { echo "[$(date '+%F %T')] $*" | tee -a "$ST/update.log"; }
mod_heads() { for d in "$MM"/modules/*/; do [ -d "$d/.git" ] && git -C "$d" rev-parse HEAD; done; }
MOD_EVERY=$((6 * 3600))

old=$(git rev-parse HEAD)
remote=$(timeout 30 git ls-remote origin refs/heads/master 2>/dev/null) || exit 0
remote=${remote%%[[:space:]]*}
[ -n "$remote" ] || exit 0
[ "$remote" = "$(cat "$ST/bad" 2>/dev/null)" ] && remote=$old
last=$(stat -c %Y "$ST/mods-checked" 2>/dev/null || echo 0)
mods_due=0; [ $(( $(date +%s) - last )) -ge $MOD_EVERY ] && mods_due=1
[ "$remote" = "$old" ] && [ $mods_due = 0 ] && exit 0

oldmods=$(mod_heads)
if [ "$remote" != "$old" ]; then
  if git fetch -q origin master; then
    git merge --ff-only -q origin/master || log "kan ikke fast-forwarde origin/master (lokale endringer?)"
  else log "git fetch feilet"; fi
fi

if [ $mods_due = 1 ]; then
  while read -r name url; do
    [ -z "${name:-}" ] || [[ $name == \#* ]] && continue
    if [ -d "modules/$name/.git" ]; then git -C "modules/$name" pull -q --ff-only || log "pull feilet: $name"
    elif [ ! -e "modules/$name" ]; then git clone -q --depth 1 "$url" "modules/$name" || log "clone feilet: $name"; fi
  done < kiosk/modules.list
  touch "$ST/mods-checked"
fi

new=$(git rev-parse HEAD)
if [ "$new" = "$old" ] && [ "$(mod_heads)" = "$oldmods" ]; then
  "$HOME/.local/bin/mm-deps" >/dev/null 2>&1; log "ingen nye endringer ($(git describe --tags --always))"; exit 0
fi

bash kiosk/install.sh >/dev/null 2>&1

LIVE='^greetings\.md$'
if [ "$(mod_heads)" = "$oldmods" ] && ! git diff --name-only "$old" "$new" | grep -qvE "$LIVE"; then
  log "kun hilsener oppdatert: ${old:0:8} -> ${new:0:8} (ingen omstart)"; exit 0
fi

log "oppdaterer: ${old:0:8} -> ${new:0:8}"
"$HOME/.local/bin/mm-deps"
systemctl --user restart magicmirror
for _ in $(seq 45); do sleep 2; curl -sf -o /dev/null http://localhost:8080 && { rm -f "$ST/bad"; log "OK ($(git describe --tags --always))"; exit 0; }; done
log "speilet kom ikke opp – ruller tilbake til ${old:0:8}, hopper over ${new:0:8} til en nyere commit kommer"
echo "$new" > "$ST/bad"
git reset -q --hard "$old"; bash kiosk/install.sh >/dev/null 2>&1; "$HOME/.local/bin/mm-deps"; systemctl --user restart magicmirror
exit 1
