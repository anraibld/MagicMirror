#!/bin/bash
# Installerer npm-avhengigheter for kjernen og modulene når package(-lock).json har endret seg.
export PATH="$HOME/.local/node/bin:$PATH" ELECTRON_SKIP_BINARY_DOWNLOAD=1
MM="$HOME/MagicMirror"; ST="$HOME/.cache/mm"; mkdir -p "$ST"
cd "$MM" || exit 0
npm_if_changed() { # dir stampname
  local dir=$1 name=$2 h
  h=$(cat "$dir/package.json" "$dir/package-lock.json" 2>/dev/null | sha256sum | cut -c1-24)-$(node -v)
  if [ ! -d "$dir/node_modules" ] || [ "$(cat "$ST/deps-$name" 2>/dev/null)" != "$h" ]; then
    echo "npm install: $name"
    (cd "$dir" && timeout 900 npm install --omit=dev --no-audit --no-fund) && echo "$h" > "$ST/deps-$name"
  fi
}
npm_if_changed "$MM" core
for d in "$MM"/modules/*/; do
  n=$(basename "$d"); [ "$n" = default ] && continue
  [ -f "$d/package.json" ] && npm_if_changed "${d%/}" "$n"
done
exit 0
